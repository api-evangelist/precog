          "id": "fdc09924-e7fb-4657-be5d-e11f2db3530d",
          "name": "Get cross-source relationship candidates",
          "request": {
            "name": "Get cross-source relationship candidates",
            "description": {
              "content": "Returns scored candidate join columns across the requested sources within a\npipeline. Each candidate pairs two fully-qualified destination columns with a\nscore indicating the likelihood that the join is useful.\n\nCandidates are ordered by score descending. Scores are ordinal within a single\nresponse and should not be compared across calls.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data-model",
                "relationship-candidates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pipeline",
                  "value": "<string>",
                  "description": "(Required) ID of the pipeline whose destination layout is used to resolve column references."
                },
                {
                  "disabled": false,
                  "key": "sources",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of source IDs to consider. At least two sources must be\nprovided.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
