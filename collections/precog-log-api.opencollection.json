{
  "opencollection": "1.0.0",
  "info": {
    "name": "http-api Admin Log API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Log",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Log a message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:30000/log",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Log a message"
        }
      ]
    }
  ],
  "bundled": true
}